<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/bgOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ScrollView (fase 6.1): status + explanation card + 3 buttons can
         exceed 720p; fillViewport keeps short content centered like
         before, tall content scrolls with D-pad focus. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="120dp"
        android:paddingTop="24dp"
        android:paddingEnd="120dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tombol Home Langsung ke Sini"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeOverrideStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="#FFD166"
            android:textSize="17sp" />

        <!-- Honest explanation card: why this route exists, what the
             service does and does not do, and how to undo it. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/menu_item"
            android:gravity="start"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:text="Google TV tidak mengizinkan launcher ini jadi Beranda lewat cara biasa. Cara ini memakai layanan aksesibilitas yang HANYA mengawasi tombol Home lalu membuka launcher ini — tidak membaca isi layar. Aktifkan sekali di Setelan → Aksesibilitas → &quot;Mot TV — Tombol Home&quot;. Bisa dimatikan kapan saja dari menu yang sama."
            android:textColor="#E8FFFFFF"
            android:textSize="14sp" />

        <!-- Diagnostic card (fase 6.2): renders the ServiceDiary so we
             can see whether the system EVER binds HomeInterceptService
             on TVs where the enable toggle silently reverts. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/menu_item"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diagnostik Layanan"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/homeDiagConnected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#E8FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/homeDiagCounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#E8FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/homeDiagError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#E8FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/homeDiagInterpretation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFD166"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/homeOverrideEnable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/mot_focus_gold"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="24dp"
            android:paddingTop="11dp"
            android:paddingEnd="24dp"
            android:paddingBottom="11dp"
            android:text="Aktifkan di Setelan TV"
            android:textColor="#26221A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/homeOverrideToggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/mot_focus_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="24dp"
            android:paddingTop="11dp"
            android:paddingEnd="24dp"
            android:paddingBottom="11dp"
            android:text="Override: ON"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/homeOverrideBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/mot_focus_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="24dp"
            android:paddingTop="11dp"
            android:paddingEnd="24dp"
            android:paddingBottom="11dp"
            android:text="← Kembali"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
