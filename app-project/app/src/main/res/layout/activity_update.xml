<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/bgOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ScrollView (fase 6.1): title + status + release-notes card +
         buttons can exceed 720p; fillViewport keeps short content
         centered exactly like before, tall content scrolls with focus. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="120dp"
        android:paddingTop="24dp"
        android:paddingEnd="120dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cek Pembaruan"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/updateVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="#FFD166"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/updateStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:textColor="#C8FFFFFF"
            android:textSize="17sp" />

        <!-- Release-notes excerpt card, only when a newer version exists. -->
        <TextView
            android:id="@+id/updateNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/menu_item"
            android:gravity="start"
            android:maxLines="8"
            android:ellipsize="end"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:textColor="#E8FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/updateAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="@drawable/mot_focus_gold"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="24dp"
            android:paddingTop="11dp"
            android:paddingEnd="24dp"
            android:paddingBottom="11dp"
            android:text="Periksa Pembaruan"
            android:textColor="#26221A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/updateBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/mot_focus_pill"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="24dp"
            android:paddingTop="11dp"
            android:paddingEnd="24dp"
            android:paddingBottom="11dp"
            android:text="← Kembali"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
