<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/bgOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="30dp"
        android:paddingEnd="48dp"
        android:paddingBottom="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengaturan"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="330dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/menuBackground"
                    style="@style/SettingsMenuItem"
                    android:text="Background" />

                <TextView
                    android:id="@+id/menuLocation"
                    style="@style/SettingsMenuItem"
                    android:text="Lokasi Sholat" />

                <TextView
                    android:id="@+id/menuLanguage"
                    style="@style/SettingsMenuItem"
                    android:text="Bahasa" />

                <TextView
                    android:id="@+id/menuUpdate"
                    style="@style/SettingsMenuItem"
                    android:text="Cek Pembaruan" />

                <TextView
                    android:id="@+id/menuDefaultHome"
                    style="@style/SettingsMenuItem"
                    android:text="Jadikan Launcher Default" />

                <TextView
                    android:id="@+id/menuAndroid"
                    style="@style/SettingsMenuItem"
                    android:text="Pengaturan TV (Android) ↗"
                    android:textColor="#FFD166" />

                <TextView
                    android:id="@+id/menuAbout"
                    style="@style/SettingsMenuItem"
                    android:text="Tentang" />
            </LinearLayout>

            <TextView
                android:id="@+id/settingsHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:layout_weight="1"
                android:text="Pilih menu di kiri."
                android:textColor="#A8FFFFFF"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
