<?xml version="1.0" encoding="utf-8"?>
<!-- Home-button override (Fase 6). Deliberately minimal powers:
     key-event filtering for the Home button + window-state events as a
     safety net. Window CONTENT retrieval stays OFF — the service never
     reads what is on screen. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/home_service_desc"
    android:notificationTimeout="100" />
