<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Launcher needs to see installed apps (tiles / games list). Sideloaded app. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Home Wi-Fi status indicator: network/Wi-Fi state + signal level.
         SSID additionally needs location permission on modern Android; the
         indicator degrades honestly to "Wi-Fi Terhubung" without it. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Self-update (phase 5): install APKs downloaded from the project's
         own GitHub Releases. Still needs the user's one-time "unknown
         sources" grant for this app before the installer can run. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <queries>
        <package android:name="com.netflix.ninja" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.tencent.qqlive" />
        <package android:name="com.vidio.android.tv" />
        <package android:name="com.vidio.android" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.android.vending" />
    </queries>

    <application
        android:allowBackup="true"
        android:banner="@drawable/app_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TvLauncher"
        android:usesCleartextTraffic="false">

        <!-- Self-update (phase 5): serves the downloaded update APK from
             cache to the system installer via a content URI. FileProvider
             ships inside androidx.core (already pulled in by core-ktx). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|locale"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".GamesActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".AllAppsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".BrowserActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".ResultsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".CalendarActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".SholatActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".BolaActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".BackgroundActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".PlaceholderActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".UpdateActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
    </application>
</manifest>
